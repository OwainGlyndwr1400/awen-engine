# ============================================================
#  Privacy-first .gitignore — EVERYTHING is ignored by default.
#  Only explicitly whitelisted files below can ever be committed.
#  Memory archives, dream pings, cheat sheets, logs, snapshots and
#  the real config.json (which holds credentials) all stay local.
#
#  To publish a new file you must add an explicit "!name" line.
#  Do not weaken this by removing the leading "*".
# ============================================================
*
*/

# --- meta ---
!.gitignore
!README.md
!LICENSE.md
!requirements.txt
!config.example.json

# --- the stack ---
!Gnostic Engine v9.8.py
!Gnostic Echo Protocol v10.0.py
!Tesla Soul Engine v9.py
!RHF Client v12.0 - Sovereign Edition.py

# --- command deck ---
!Awen Command Deck.py
!awen_deck.html
!awen_map.html
!build_neural_map.py

# --- vendored libs (offline-proof) ---
!vendor/
!vendor/*.js
# NB: docs/neural_map.json is generated from the local corpus and stays local —
# build_neural_map.py regenerates it from whatever vault the user has.

# --- corpus tooling ---
!ingest_memory.py
!ingest_books.py
!rebuild_gnosis.py

# --- instruments (v2) ---
# The BUILDERS ship; their OUTPUT never does. atlas.json / regulus_corridor.json
# / neural_map.json are all derived from the local corpus — the atlas in
# particular carries cluster labels drawn from the conversations lane, which is
# the one lane that must never leave the machine. docs/ only admits *.png|*.jpg,
# so those artifacts are already blocked; this note is here so nobody "fixes"
# that by adding !docs/*.json.
!build_atlas.py
!build_regulus_corridor.py
!runtime_vs_spec.py

# --- launchers ---
!Start Awen Grid.bat
!stop_grid.ps1

# --- docs assets (screenshots only) ---
!docs/
!docs/*.png
!docs/*.jpg
